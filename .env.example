# Required for the AI agent. Free key (no card): https://console.groq.com/keys
# Without it the app still works using the rule-based fallback planner.
GROQ_API_KEY=

# Optional but recommended: reliable live OpenStreetMap places with opening hours
# and diet tags. Free tier 3,000 credits/day, no card: https://myprojects.geoapify.com
# Without it the app uses the public Photon server, then the curated list.
GEOAPIFY_API_KEY=

# Optional overrides (comma-separated fallback chains, first = preferred)
# GROQ_UNDERSTAND_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b
# GROQ_PLAN_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# GROQ_REASONING_EFFORT=low
